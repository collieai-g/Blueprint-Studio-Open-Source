{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:shared-harness:case:1",
  "title": "可重現的上游回饋案例",
  "type": "object",
  "required": ["contract_version", "case_id", "project_id", "title", "source_revision", "observations", "expected", "required_checks", "required_attestations", "public_status", "instance_status", "scope"],
  "properties": {
    "contract_version": {"const": 1},
    "case_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,99}$"},
    "project_id": {"type": "string"},
    "title": {"type": "string"},
    "source_revision": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
    "observations": {
      "type": "array", "minItems": 1,
      "items": {"type": "object", "required": ["id", "classification", "status", "summary", "private_evidence_required"],
        "properties": {"id": {"type": "string"}, "classification": {"enum": ["client_compatibility_gap", "introduced_adapter_bug", "product_bug", "installation_bug"]}, "status": {"type": "string"}, "summary": {"type": "string"}, "private_evidence_required": {"type": "boolean"}},
        "additionalProperties": false}
    },
    "expected": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "required_checks": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "required_attestations": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "public_status": {"const": "candidate_not_submitted"},
    "instance_status": {"const": "external_private_evidence_only"},
    "scope": {"type": "string"}
  },
  "additionalProperties": false
}
