{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:shared-harness:project:1",
  "title": "共用 harness 項目接入設定",
  "type": "object",
  "required": ["contract_version", "project_id", "source_repository", "source_revision", "lifecycle", "checks", "required_attestations", "bundle_files"],
  "properties": {
    "contract_version": {"const": 1},
    "project_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,99}$"},
    "source_repository": {"type": "string", "pattern": "^https://github\\.com/[^/]+/[^/]+$"},
    "source_tag": {"type": "string"},
    "source_revision": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
    "browser_fixture": {"$ref": "#/$defs/relative_file"},
    "lifecycle": {
      "type": "object", "required": ["kind", "entrypoint", "task"],
      "properties": {"kind": {"enum": ["blueprint-lifecycle-v1", "reference-only"]}, "entrypoint": {"$ref": "#/$defs/relative_file"}, "task": {"type": "string"}},
      "additionalProperties": false
    },
    "checks": {
      "type": "object", "minProperties": 1,
      "additionalProperties": {
        "type": "object", "required": ["argv", "timeout_seconds", "inputs"],
        "properties": {
          "argv": {"type": "array", "minItems": 1, "maxItems": 100, "items": {"type": "string"}},
          "timeout_seconds": {"type": "number", "exclusiveMinimum": 0, "maximum": 300},
          "inputs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/relative_file"}}
        }, "additionalProperties": false
      }
    },
    "required_attestations": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "bundle_files": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/relative_file"}}
  },
  "allOf": [{"if": {"properties": {"required_attestations": {"contains": {"const": "browser_form_regression"}}}}, "then": {"required": ["browser_fixture"]}}],
  "$defs": {"relative_file": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)[^:]+$"}},
  "additionalProperties": false
}
