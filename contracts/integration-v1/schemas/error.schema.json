{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "error": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "code": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "retryable": {
      "type": "boolean"
    }
  },
  "required": [
    "error",
    "code",
    "retryable"
  ]
}
