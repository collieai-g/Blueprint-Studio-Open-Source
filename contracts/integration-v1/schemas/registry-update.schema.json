{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "expected_version": {
      "type": "integer",
      "minimum": 1
    },
    "enabled": {
      "type": "boolean"
    },
    "record_types": {
      "type": "array",
      "minItems": 1,
      "maxItems": 7,
      "uniqueItems": true,
      "items": {
        "enum": [
          "thread",
          "message",
          "work_item",
          "artifact",
          "note",
          "status",
          "knowledge"
        ]
      }
    },
    "resource_refs": {
      "type": "array",
      "maxItems": 100,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "kind": {
            "enum": [
              "item",
              "report"
            ]
          },
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          }
        },
        "required": [
          "kind",
          "id"
        ]
      }
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "app_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "commands": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80,
            "pattern": "^[a-zA-Z][a-zA-Z0-9_.-]{0,79}$"
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "input_schema": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "type": {
                "const": "object"
              },
              "properties": {
                "type": "object",
                "maxProperties": 32,
                "additionalProperties": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "type": {
                      "enum": [
                        "string",
                        "integer",
                        "number",
                        "boolean"
                      ]
                    },
                    "title": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 200
                    },
                    "maxLength": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 40000
                    },
                    "enum": {
                      "type": "array",
                      "minItems": 1,
                      "maxItems": 64,
                      "items": {
                        "type": [
                          "string",
                          "number",
                          "boolean"
                        ]
                      }
                    }
                  },
                  "required": [
                    "type"
                  ],
                  "allOf": [
                    {
                      "if": {
                        "required": [
                          "maxLength"
                        ]
                      },
                      "then": {
                        "properties": {
                          "type": {
                            "const": "string"
                          }
                        }
                      }
                    }
                  ]
                },
                "propertyNames": {
                  "pattern": "^[a-zA-Z][a-zA-Z0-9_.-]{0,79}$",
                  "not": {
                    "enum": [
                      "__proto__",
                      "prototype",
                      "constructor"
                    ]
                  }
                }
              },
              "required": {
                "type": "array",
                "maxItems": 32,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "pattern": "^[a-zA-Z][a-zA-Z0-9_.-]{0,79}$"
                }
              },
              "additionalProperties": {
                "const": false
              }
            },
            "required": [
              "type",
              "properties",
              "required",
              "additionalProperties"
            ]
          }
        },
        "required": [
          "name",
          "label",
          "input_schema"
        ]
      }
    },
    "allowed_origins": {
      "type": "array",
      "maxItems": 20,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "format": "uri",
        "pattern": "^https://"
      }
    }
  },
  "required": [
    "expected_version"
  ]
}
