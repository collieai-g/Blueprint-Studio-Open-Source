{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "integration_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "pattern": "^[a-zA-Z][a-zA-Z0-9_.-]{0,79}$"
    },
    "payload": {
      "type": "object"
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "record_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "correlation_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "control_epoch": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "input_cursor": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "integration_id",
    "name",
    "payload",
    "idempotency_key"
  ],
  "description": "Workspace user intent; only approved declared actions and validated primitive payloads are accepted. Initial state pending is not action completion. Provider control_epoch and input_cursor are separate from the platform version."
}
