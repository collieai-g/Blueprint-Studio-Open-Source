# Reference only. Use scripts/v2/configure.sh (or configure.ps1) to generate a
# private .env, credentials and signing certificate OUTSIDE this checkout.
COMPOSE_PROJECT_NAME=blueprint-workspace
POSTGRES_PASSWORD=
BLUEPRINT_SETUP_TOKEN=
# Exactly 64 hexadecimal characters. Keep stable across upgrades/restores.
BLUEPRINT_MASTER_KEY=
BLUEPRINT_PUBLIC_URL=http://127.0.0.1:8787
BLUEPRINT_LISTEN_ADDRESS=127.0.0.1
BLUEPRINT_PORT=8787
BLUEPRINT_SECRETS_DIR=

# Leave these empty for the basic local-files profile. The documents/enterprise
# Compose overrides configure the matching internal service URLs.
BLUEPRINT_GOTENBERG_URL=
BLUEPRINT_TIKA_URL=
BLUEPRINT_CLAMAV_URL=
BLUEPRINT_S3_ENDPOINT=
BLUEPRINT_S3_BUCKET=blueprint
BLUEPRINT_S3_REGION=us-east-1
BLUEPRINT_S3_REQUIRE_OBJECT_LOCK=1
BLUEPRINT_S3_ACCESS_KEY=
BLUEPRINT_S3_SECRET_KEY=
# Seaweed 0 auto-calculates volume capacity from disk. Each bucket collection
# reserves several volume slots; small disposable multi-bucket tests may use
# MAX_VOLUMES=64 and VOLUME_SIZE_MB=32. Monitor actual free disk before changing.
BLUEPRINT_SEAWEED_MAX_VOLUMES=0
BLUEPRINT_SEAWEED_VOLUME_SIZE_MB=1024

# Optional self-hosted CE signing service. The API token must be created by its
# administrator. It is not generated or guessed by Blueprint.
BLUEPRINT_DOCUMENSO_URL=
BLUEPRINT_DOCUMENSO_API_TOKEN=
BLUEPRINT_DOCUMENSO_WEBHOOK_SECRET=
BLUEPRINT_DOCUMENSO_PUBLIC_URL=http://127.0.0.1:3001
DOCUMENSO_DB_PASSWORD=
DOCUMENSO_AUTH_SECRET=
DOCUMENSO_ENCRYPTION_KEY=
DOCUMENSO_SECONDARY_KEY=
DOCUMENSO_SIGNING_PASSWORD=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_NAME=Blueprint Studio
SMTP_FROM_ADDRESS=

# Optional enterprise identity and Office editor.
BLUEPRINT_KEYCLOAK_URL=
BLUEPRINT_KEYCLOAK_PUBLIC_URL=http://127.0.0.1:8081
BLUEPRINT_OIDC_ISSUER=
BLUEPRINT_OIDC_REALM=blueprint
BLUEPRINT_OIDC_CLIENT_ID=blueprint
BLUEPRINT_OIDC_CLIENT_SECRET=
KEYCLOAK_DB_PASSWORD=
KEYCLOAK_ADMIN_USER=blueprint-admin
KEYCLOAK_ADMIN_PASSWORD=
BLUEPRINT_COLLABORA_URL=
BLUEPRINT_COLLABORA_PUBLIC_URL=http://127.0.0.1:9980
BLUEPRINT_COLLABORA_WOPI_ORIGIN=http://app:8787
COLLABORA_ADMIN_USER=blueprint-admin
COLLABORA_ADMIN_PASSWORD=

# Personal Google/Microsoft calendar OAuth applications, registered by deployer.
# Redirect URL: <BLUEPRINT_PUBLIC_URL>/api/v1/public/calendar/oauth/<provider>
BLUEPRINT_GOOGLE_CLIENT_ID=
BLUEPRINT_GOOGLE_CLIENT_SECRET=
BLUEPRINT_MICROSOFT_CLIENT_ID=
BLUEPRINT_MICROSOFT_CLIENT_SECRET=

# Public HTTPS: set BLUEPRINT_PUBLIC_URL and BLUEPRINT_SITE to your real domain,
# then add --profile https when starting Compose. DNS must point to your server.
BLUEPRINT_SITE=http://localhost
BLUEPRINT_HTTP_PORT=80
BLUEPRINT_HTTPS_PORT=443

# Versioned defaults. Override only after validating the selected image/version.
BLUEPRINT_POSTGRES_IMAGE=blueprint-postgres:4.1.0-pg17
BLUEPRINT_APP_IMAGE=blueprint-backend:2.0.0-alpha.1
BLUEPRINT_SEAWEED_IMAGE=chrislusf/seaweedfs:4.48
BLUEPRINT_GOTENBERG_IMAGE=gotenberg/gotenberg:8.38.1
BLUEPRINT_TIKA_IMAGE=blueprint-tika:3.2.3.0-full
BLUEPRINT_CLAMAV_IMAGE=clamav/clamav:1.5.4
BLUEPRINT_DOCUMENSO_IMAGE=ghcr.io/documenso/documenso:v2.21.0
BLUEPRINT_KEYCLOAK_IMAGE=quay.io/keycloak/keycloak:26.8.1
BLUEPRINT_COLLABORA_IMAGE=collabora/code:25.04.7.2.1
BLUEPRINT_CADDY_IMAGE=caddy:2.10.2-alpine
