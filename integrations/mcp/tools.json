          "expected_version": {
            "type": "integer",
            "minimum": 1
          },
          "title": {
            "type": "string",
            "maxLength": 500
          },
          "summary": {
            "type": "string",
            "maxLength": 16000
          },
          "entries": {
            "type": "array",
            "minItems": 1,
            "maxItems": 80,
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "maxLength": 100,
                  "pattern": "^[A-Za-z0-9-]{1,100}$"
                },
                "type": {
                  "type": "string",
                  "enum": [
                    "outcome",
                    "decision",
                    "reference",
                    "todo"
                  ]
                },
                "title": {
                  "type": "string",
                  "maxLength": 500
                },
                "content": {
                  "type": "string",
                  "maxLength": 16000
                },
                "url": {
                  "type": "string",
                  "maxLength": 8192
                },
                "tags": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "maxLength": 100
                  },
                  "maxItems": 16
                },
                "due_date": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "maxLength": 10
                }
              },
              "required": [
                "type",
                "title"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "id",
          "expected_version",
          "entries"
        ],
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": true,
        "idempotentHint": false,
        "openWorldHint": false
      },
      "route": {
        "method": "PATCH",
        "path": "/api/workdays/{id}"
      }
    },
