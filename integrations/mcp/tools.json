    {
      "name": "blueprint_get_workday",
      "title": "讀取工作紀錄",
      "description": "Read the current workday version and stable entry IDs before editing.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 100,
            "pattern": "^[A-Za-z0-9-]{1,100}$"
