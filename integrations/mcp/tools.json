    {
      "name": "blueprint_save_text_file",
      "title": "保存文字文件",
      "description": "Save user-approved generated text as a real UTF-8 file in this same workspace. Never read arbitrary local paths or store secrets. Original uploads remain immutable; this creates a new file.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 255
          },
          "mime": {
            "type": "string",
            "maxLength": 200
          },
          "notes": {
            "type": "string",
            "maxLength": 16000
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 100
            },
            "maxItems": 16
          },
          "collection_id": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 100
          },
          "text": {
            "type": "string",
            "maxLength": 100000
          }
        },
        "required": [
          "name",
          "text"
        ],
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": false,
        "idempotentHint": false,
        "openWorldHint": false
      },
      "route": {
        "method": "POST",
        "path": "/api/files",
        "transform": "utf8_file"
      }
    },
    {
      "name": "blueprint_upload_file",
      "title": "保存附件",
      "description": "Save supplied base64 file bytes, at most 300 KiB decoded. This tool cannot read local files by path. Use the authenticated workbench upload for larger files. Check existing files before retrying a timeout to avoid duplicates.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 255
          },
          "mime": {
            "type": "string",
            "maxLength": 200
          },
          "notes": {
            "type": "string",
            "maxLength": 16000
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 100
            },
            "maxItems": 16
          },
          "collection_id": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 100
          },
          "content_base64": {
            "type": "string",
            "maxLength": 409600,
            "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
          }
        },
        "required": [
          "name",
          "content_base64"
        ],
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": false,
        "idempotentHint": false,
        "openWorldHint": false
      },
      "route": {
        "method": "POST",
        "path": "/api/files"
      }
    },
    {
      "name": "blueprint_list_workdays",
      "title": "查閱每日工作",
