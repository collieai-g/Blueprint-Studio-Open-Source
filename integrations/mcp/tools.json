    {
      "name": "blueprint_save_workday",
      "title": "保存每日工作",
      "description": "Save useful outcomes, decisions, references and todos from visible or user-provided work. Set source to the actual AI/client name, and use a stable source_key per conversation/day. Identical retries preserve completed todos. Never invent unseen conversation content.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "date": {
            "type": "string",
            "maxLength": 10,
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "source": {
            "type": "string",
            "maxLength": 100
          },
          "source_key": {
            "type": "string",
            "maxLength": 200
          },
          "title": {
            "type": "string",
            "maxLength": 500
          },
          "summary": {
            "type": "string",
            "maxLength": 16000
          },
          "entries": {
            "type": "array",
            "minItems": 1,
            "maxItems": 80,
            "items": {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "enum": [
                    "outcome",
                    "decision",
                    "reference",
                    "todo"
                  ]
                },
                "title": {
                  "type": "string",
                  "maxLength": 500
                },
                "content": {
                  "type": "string",
                  "maxLength": 16000
                },
                "url": {
                  "type": "string",
                  "maxLength": 8192
                },
                "tags": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "maxLength": 100
                  },
                  "maxItems": 16
                },
                "due_date": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "maxLength": 10
                }
              },
              "required": [
                "type",
                "title"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "date",
          "source",
          "source_key",
          "entries"
        ],
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": false,
        "idempotentHint": false,
        "openWorldHint": false
      },
      "route": {
        "method": "POST",
        "path": "/api/workdays"
      }
    },
    {
      "name": "blueprint_revise_workday",
